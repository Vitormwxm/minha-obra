# Copiar para /var/www/apps/minha-obra/.env, preencher e proteger com chmod 600.
# Não versionar a cópia preenchida. Nome comercial ainda provisório.
APP_DOMAIN=replace.example.com
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_ADMIN_PASSWORD
# Gerar UUID Kafka; não alterar após o primeiro início do volume persistente.
KAFKA_CLUSTER_ID=REPLACE_WITH_A_KAFKA_CLUSTER_ID
# Chave base64 de 32 bytes; initialize_auth_key.py inicializa uma vez na VPS.
# Preservar junto do backup privado: protege os segredos TOTP dos administradores.
# APP_TOTP_ENCRYPTION_KEY é gerada pelo bootstrap/deploy; não copiar chave de teste.
# Imagens são fornecidas pelo release.json da CI, não por tags latest.
# Não inserir BACKEND_IMAGE/FRONTEND_IMAGE aqui; o deploy usa release.env separado.
